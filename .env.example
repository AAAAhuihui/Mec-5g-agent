DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
K8S_MCP_URL=http://127.0.0.1:8000/mcp
K8S_MCP_TIMEOUT_SECONDS=30
K8S_DIAGNOSTICS_MAX_LOG_LINES=500
K8S_DIAGNOSTICS_MAX_SINCE_SECONDS=86400
# Disabled by default. Only allowlisted read-only commands can run without approval.
CMD_TOOL_ENABLED=false
CMD_TOOL_TIMEOUT_SECONDS=30
CMD_TOOL_APPROVAL_TTL_SECONDS=300
CMD_TOOL_ALLOWED_WORKDIR=.
CMD_TOOL_MAX_OUTPUT_CHARS=10000
FILE_TOOL_ENABLED=true
FILE_TOOL_ALLOWED_ROOT=%USERPROFILE%\Desktop
FILE_TOOL_MAX_READ_CHARS=20000
FILE_TOOL_MAX_WRITE_CHARS=200000
REACT_MAX_STEPS=6
REACT_MAX_TOOL_CALLS=8
REACT_MAX_CMD_APPROVALS=3
REACT_MAX_FILE_APPROVALS=3
REACT_MAX_DUPLICATE_COMMANDS=2
REACT_MAX_SAME_COMMAND_RETRIES=2
REACT_MAX_NO_PROGRESS_STEPS=3
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=mec_5g_docs_structured_v2
RAG_CHUNK_MAX_TOKENS=112
RAG_CHUNK_OVERLAP_TOKENS=16
RAW_DOCS_DIR=data/raw_docs
RAG_TOP_K=6
RAG_VECTOR_CANDIDATE_K=40
RAG_BM25_CANDIDATE_K=40
RAG_FUSED_CANDIDATE_K=30
RAG_RRF_K=60
RAG_NEIGHBOR_RADIUS=1
# Use cross-encoder after placing the model on the host/container.
RERANKER_BACKEND=lightweight
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_ALLOW_DOWNLOAD=false
RERANKER_FAIL_OPEN=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mec_5g_agent

# Optional cache. Leave REDIS_HOST empty to run MySQL-only.
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CONTEXT_TTL_SECONDS=600
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
